# =============================================================================
# MVS Map Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables marked REQUIRED must be set for the server to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the HTTP/Socket.IO server listens on (REQUIRED)
PORT=3000

# Public domain used in fabric.msf.json (REQUIRED for Railway deployments)
# Set to your deployment URL without protocol, e.g. myapp.railway.app
# Falls back to RAILWAY_PUBLIC_DOMAIN if not set (Railway injects this automatically)
PUBLIC_DOMAIN=

# Your RP1 Developer Center Company ID (lowercase) (REQUIRED)
# This is used to build the fabric namespace: <COMPANY_ID>/map
COMPANY_ID=yourcompanyid

# -----------------------------------------------------------------------------
# MySQL Database (REQUIRED)
# -----------------------------------------------------------------------------

MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=MVD_RP1_Map
